{
  "_about": "riscv-emu milestones on the way to booting Linux, grouped by phase (one roadmap column each). 'detect' = regexes that must ALL match the code in src/ + include/ (comments stripped); the date is the first commit where they do, as long as HEAD still matches. Milestones without 'detect' are marked by hand: set 'done' to YYYY-MM-DD.",
  "milestones": [
    {"phase": "Core ISA",   "name": "RV32I base ISA",          "detect": ["OPCODE_B_TYPE", "OPCODE_J_TYPE", "OPCODE_S_TYPE", "OPCODE_I_LOAD_TYPE"]},
    {"phase": "Core ISA",   "name": "ELF loader",              "detect": ["\\bload_elf\\("]},
    {"phase": "Core ISA",   "name": "M: multiply/divide",      "detect": ["mulhu", "remu"]},
    {"phase": "Core ISA",   "name": "A: atomics, LR/SC",       "detect": ["amoadd", "\\bsc\\("]},
    {"phase": "Core ISA",   "name": "C: compressed",           "detect": ["compressed_reg"]},
    {"phase": "Core ISA",   "name": "Zicsr + traps",           "detect": ["csrrw", "\\btrap\\(", "MEPC"]},
    {"phase": "Core ISA",   "name": "Passes riscv-tests",      "done": null},

    {"phase": "Privileged", "name": "M/S/U modes",             "detect": ["MEDELEG", "SEPC"]},
    {"phase": "Privileged", "name": "Timer interrupts",        "detect": ["mtimecmp"]},
    {"phase": "Privileged", "name": "Sv32 MMU",                "detect": ["translate_mmu", "SATP"]},

    {"phase": "Platform",   "name": "UART output",             "detect": ["0x10000000"]},
    {"phase": "Platform",   "name": "16550 UART",              "detect": ["(?i)\\bUART_LSR\\b|\\bLSR\\b|0x10000005"]},
    {"phase": "Platform",   "name": "PLIC interrupts",         "detect": ["(?i)\\bplic"]},
    {"phase": "Platform",   "name": "SBI firmware",            "detect": ["(?i)\\bsbi_|opensbi|fw_jump"]},
    {"phase": "Platform",   "name": "Device tree handoff",     "detect": ["(?i)\\b(dtb|fdt)\\w*\\s*[=(,;]"]},
    {"phase": "Platform",   "name": "initramfs",               "detect": ["(?i)initrd|initramfs|\\bcpio"]},

    {"phase": "Linux",      "name": "Kernel Image boots",      "detect": ["load_kernel_image\\(\\s*cpu\\b"]},
    {"phase": "Linux",      "name": "Early console output",    "done": null},
    {"phase": "Linux",      "name": "Boots to a shell",        "done": null}
  ]
}
